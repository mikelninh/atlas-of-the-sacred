{
  "name": "atlas-of-the-sacred",
  "version": "0.6.0-alpha.1",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/bootstrap-source.mjs",
    "dev": "next dev",
    "build": "npm run validate:content && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "check:sources": "node scripts/check-source-health.mjs",
    "check:sources:strict": "node scripts/check-source-health.mjs --strict",
    "report:editorial": "node scripts/editorial-report.mjs",
    "quality": "npm run validate:content && npm run report:editorial && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.8.3"
  }
}
